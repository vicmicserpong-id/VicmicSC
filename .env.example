# ─────────────────────────────────────────────────────────────
# Vicmic Service SuperApp — Environment Variables
# Salin file ini menjadi .env.local lalu isi nilainya.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Storage — nama bucket foto unit & tanda tangan
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=vicmic-photos

# Resend (email rekap harian & notifikasi siap ambil)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Vicmic Service <noreply@vicmic.id>
RECAP_EMAIL_RECIPIENT=owner@vicmic.id

# Vercel Cron — secret acak: `openssl rand -hex 32`
CRON_SECRET=your-random-cron-secret-key

# URL publik aplikasi (untuk link di email & QR)
NEXT_PUBLIC_APP_URL=http://localhost:3000
