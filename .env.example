# ─────────────────────────────────────────────────────────────
# Vicmic Service SuperApp — Environment Variables
# Salin file ini menjadi .env.local lalu isi nilainya.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Storage — nama bucket foto unit & tanda tangan (dipertahankan
# hanya untuk MENAMPILKAN foto lama; unggahan baru lewat vicmic-file-server)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=vicmic-photos

# vicmic-file-server — endpoint upload/hapus foto di hosting Exabytes
# (lihat repo terpisah `vicmic-file-server`). Server-only, jangan pakai
# prefix NEXT_PUBLIC_.
PHOTO_UPLOAD_URL=https://files.vicmic.id/upload.php
PHOTO_DELETE_URL=https://files.vicmic.id/delete.php
PHOTO_UPLOAD_SECRET=your-long-random-secret-shared-with-vicmic-file-server

# Resend (email rekap harian & notifikasi siap ambil)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Vicmic Service <noreply@vicmic.id>
RECAP_EMAIL_RECIPIENT=owner@vicmic.id

# Vercel Cron — secret acak: `openssl rand -hex 32`
CRON_SECRET=your-random-cron-secret-key

# URL publik aplikasi (untuk link di email & QR)
NEXT_PUBLIC_APP_URL=http://localhost:3000
